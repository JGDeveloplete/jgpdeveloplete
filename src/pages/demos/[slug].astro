---
/**
 * Plantilla de demo de web para un oficio (ver src/lib/demos.ts).
 *
 * Dos ejes de variedad, para que sean un catálogo de verdad y no la misma
 * plantilla pintada de otro color:
 *   - `estilo.formato`: la DISPOSICIÓN (centrado / lateral / banda / elegante).
 *   - `tipo`: la FUNCIONALIDAD que demuestra:
 *       reservas  → calendario + horas (pedir cita).
 *       contacto  → formulario de captación de casos.
 *       catalogo  → carta de servicios con reserva por tarjeta.
 *
 * Maqueta ESTÁTICA: todo se genera/valida en el navegador y no envía ni guarda
 * nada. Profesional ficticio («Ejemplo»). Lleva noindex.
 */
import { demos } from "../../lib/demos";
import { CSP } from "../../lib/seguridad";

export function getStaticPaths() {
  return demos.map((demo) => ({ params: { slug: demo.slug }, props: { demo } }));
}

const { demo } = Astro.props;
const p = demo.paleta;
const e = demo.estilo;

// Iconos para las tarjetas de área del asistente de contacto (abogacía).
// Son SVG estáticos (line icons); se eligen por orden.
const ICONOS_AREA = [
  '<path d="M3 7h18v12H3z"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 12h18"/>',
  '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/>',
  '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  '<path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/>',
  '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/><path d="M9 13h6"/><path d="M9 17h4"/>',
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={CSP} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{`Demo · ${demo.profesion} — JGP Developlete`}</title>
    <meta name="description" content={`Ejemplo de web para ${demo.profesion.toLowerCase()}. Demostración ficticia, sin datos reales.`} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={e.fuenteImport} rel="stylesheet" />
    <style set:html={`:root{
      --fondo:${p.fondo}; --tinta:${p.tinta}; --principal:${p.principal};
      --acento:${p.acento}; --suave:${p.suave}; --linea:${p.linea};
      --fuente-titulo:${e.fuenteTitulo};
    }`}></style>
    <style is:global>
      * { box-sizing: border-box; }
      body { margin: 0; font-family: "Inter", system-ui, sans-serif; color: var(--tinta); background: var(--fondo); line-height: 1.6; -webkit-font-smoothing: antialiased; }
      h1, h2, h3 { font-family: var(--fuente-titulo); font-weight: 600; line-height: 1.15; margin: 0; }
      img { max-width: 100%; display: block; }
      .env { width: min(100% - 2rem, 980px); margin-inline: auto; }

      .demo-cinta { position: sticky; top: 0; z-index: 20; background: var(--tinta); color: #fff; font-size: .84rem; text-align: center; padding: .6rem 1rem; }
      .demo-cinta strong { color: var(--acento); }

      /* Botón «volver» flotante, siempre visible mientras se navega la demo. */
      .volver { position: fixed; left: 1rem; bottom: 1rem; z-index: 40; display: inline-flex; align-items: center; gap: .45rem; padding: .7rem 1.15rem; border-radius: 999px; background: var(--tinta); color: #fff; text-decoration: none; font-size: .9rem; font-weight: 600; box-shadow: 0 10px 26px rgba(0,0,0,.22); }
      .volver:hover { background: var(--principal); }

      .cab { padding: 2.4rem 0 1rem; }
      .cab-fila { display: flex; align-items: center; gap: .8rem; }
      .cab-ini { width: 46px; height: 46px; border-radius: 50%; flex: none; display: grid; place-items: center; background: var(--principal); color: #fff; font-family: var(--fuente-titulo); font-size: 1.4rem; }
      .cab-nombre { font-size: 1.15rem; font-weight: 600; }
      .cab-rol { font-size: .82rem; letter-spacing: .12em; text-transform: uppercase; color: var(--acento); }

      .hero { padding: 1.5rem 0 2.5rem; }
      .hero h1 { font-size: clamp(1.9rem, 5vw, 3rem); max-width: 16ch; }
      .hero p { font-size: clamp(1.05rem, 2.5vw, 1.2rem); max-width: 50ch; color: color-mix(in srgb, var(--tinta) 72%, transparent); margin: 1rem 0 0; }

      main { padding-top: .5rem; padding-bottom: 1rem; }
      .panel { background: #fff; border: 1px solid var(--linea); border-radius: 16px; box-shadow: 0 14px 40px rgba(0,0,0,.08); padding: clamp(1.2rem, 4vw, 2.2rem); margin-bottom: 3rem; }
      .panel > h2 { font-size: 1.5rem; margin-bottom: .3rem; }
      .panel .ayuda { color: color-mix(in srgb, var(--tinta) 60%, transparent); font-size: .95rem; margin: 0 0 1.6rem; }
      .paso-titulo { font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; color: var(--acento); margin: 0 0 .8rem; font-weight: 600; }

      /* ---------- Reservas ---------- */
      .reserva-cols { display: block; }
      .col-agenda { margin-top: 2rem; }
      .servicios { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: .8rem; }
      .servicio { text-align: left; background: var(--fondo); border: 1.5px solid var(--linea); border-radius: 12px; padding: 1rem 1.1rem; cursor: pointer; font: inherit; color: inherit; transition: border-color .15s, transform .15s; }
      .servicio:hover { border-color: var(--principal); transform: translateY(-2px); }
      .servicio[aria-pressed="true"] { border-color: var(--principal); box-shadow: inset 0 0 0 1.5px var(--principal); }
      .servicio-nombre { font-weight: 600; display: block; }
      .servicio-meta { font-size: .88rem; color: color-mix(in srgb, var(--tinta) 60%, transparent); }
      .cal-cab { display: flex; align-items: center; justify-content: space-between; margin-bottom: .9rem; }
      .cal-mes { font-family: var(--fuente-titulo); font-size: 1.2rem; text-transform: capitalize; }
      .cal-nav { display: flex; gap: .4rem; }
      .cal-btn { width: 38px; height: 38px; border-radius: 10px; border: 1.5px solid var(--linea); background: #fff; cursor: pointer; font-size: 1.1rem; color: var(--tinta); display: grid; place-items: center; }
      .cal-btn:disabled { opacity: .35; cursor: default; }
      .cal-rejilla { display: grid; grid-template-columns: repeat(7, 1fr); gap: .35rem; }
      .cal-dow { text-align: center; font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; color: color-mix(in srgb, var(--tinta) 45%, transparent); padding-bottom: .3rem; }
      .cal-dia { aspect-ratio: 1; border: 0; background: transparent; border-radius: 10px; font: inherit; font-size: .95rem; color: var(--tinta); cursor: pointer; display: grid; place-items: center; }
      .cal-dia.vacio { cursor: default; }
      .cal-dia.libre { background: var(--suave); font-weight: 600; }
      .cal-dia.libre:hover { background: var(--principal); color: #fff; }
      .cal-dia.nodisp { color: color-mix(in srgb, var(--tinta) 30%, transparent); cursor: default; }
      .cal-dia.sel { background: var(--principal); color: #fff; }
      .horas { margin-top: 1.6rem; }
      .horas-lista { display: flex; flex-wrap: wrap; gap: .5rem; }
      .hora { padding: .6rem 1rem; border: 1.5px solid var(--linea); background: #fff; border-radius: 10px; font: inherit; cursor: pointer; transition: border-color .15s, background .15s, color .15s; }
      .hora:hover { border-color: var(--acento); background: var(--fondo); }
      .placeholder { color: color-mix(in srgb, var(--tinta) 45%, transparent); font-size: .95rem; }

      /* ---------- Contacto (captación) ---------- */
      .form-grid { display: grid; gap: 1.1rem; }
      .campo { display: grid; gap: .4rem; }
      .campo label { font-size: .82rem; font-weight: 600; letter-spacing: .04em; }
      .campo input, .campo select, .campo textarea { width: 100%; padding: .8rem 1rem; border: 1.5px solid var(--linea); border-radius: 10px; font: inherit; color: var(--tinta); background: var(--fondo); }
      .campo input:focus-visible, .campo select:focus-visible, .campo textarea:focus-visible { outline: 2px solid var(--principal); outline-offset: 1px; }
      .campo textarea { min-height: 120px; resize: vertical; }
      .campo-fila { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
      .form-check { display: flex; align-items: flex-start; gap: .6rem; font-size: .9rem; color: color-mix(in srgb, var(--tinta) 70%, transparent); }
      /* Asistente de contacto: paso 1, elegir área con tarjetas. */
      .areas-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: .9rem; margin-top: 1.4rem; }
      .area-op { display: flex; align-items: center; gap: .9rem; text-align: left; background: var(--fondo); border: 1.5px solid var(--linea); border-radius: 14px; padding: 1.1rem 1.2rem; cursor: pointer; font: inherit; color: var(--tinta); transition: border-color .15s, transform .15s, box-shadow .2s; }
      .area-op:hover { border-color: var(--principal); transform: translateY(-3px); box-shadow: 0 12px 26px rgba(0,0,0,.09); }
      .area-ico { flex: none; width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; color: var(--principal); background: var(--suave); }
      .area-nombre { font-weight: 600; flex: 1; }
      .area-flecha { color: var(--acento); font-weight: 700; transition: transform .15s; }
      .area-op:hover .area-flecha { transform: translateX(4px); }
      .wiz-volver { background: none; border: 0; color: var(--principal); font: inherit; font-weight: 600; cursor: pointer; padding: 0; margin-bottom: 1rem; }
      .wiz-chip { color: var(--principal); }

      /* ---------- Catálogo (carta) ---------- */
      .carta { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.1rem; }
      .trato { background: var(--fondo); border: 1px solid var(--linea); border-radius: 14px; padding: 1.3rem; display: flex; flex-direction: column; }
      .trato-cab { display: flex; align-items: baseline; justify-content: space-between; gap: .6rem; }
      .trato-nombre { font-family: var(--fuente-titulo); font-size: 1.25rem; }
      .trato-precio { font-weight: 700; color: var(--principal); white-space: nowrap; }
      .trato-dur { font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; color: var(--acento); margin: .2rem 0 .7rem; }
      .trato-desc { color: color-mix(in srgb, var(--tinta) 68%, transparent); font-size: .95rem; margin: 0 0 1.2rem; }
      .trato .cta { margin-top: auto; }

      /* ---------- Onboarding (cuestionario por pasos) ---------- */
      .ob-progreso { height: 6px; background: var(--suave); border-radius: 999px; overflow: hidden; margin-bottom: .5rem; }
      .ob-barra { display: block; height: 100%; width: 0; background: var(--principal); transition: width .35s ease; }
      .ob-contador { font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; color: color-mix(in srgb, var(--tinta) 50%, transparent); margin: 0 0 1.6rem; text-align: right; }
      .ob-atras { background: none; border: 0; color: var(--principal); font: inherit; font-weight: 600; cursor: pointer; padding: 0; margin-bottom: .6rem; }
      .ob-paso h2 { font-size: clamp(1.3rem, 3vw, 1.7rem); margin-bottom: 1.4rem; text-align: center; }
      .ob-ops { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }
      .ob-op { padding: 1.15rem 1.2rem; border: 1.5px solid var(--linea); border-radius: 14px; background: var(--fondo); font: inherit; font-weight: 600; color: var(--tinta); cursor: pointer; transition: border-color .15s, transform .15s, background .15s, box-shadow .2s; }
      .ob-op:hover { border-color: var(--principal); transform: translateY(-3px); background: #fff; box-shadow: 0 12px 26px rgba(0,0,0,.08); }
      .ob-final { text-align: center; }
      .ob-resumen { background: var(--suave); border-radius: 12px; padding: .9rem 1rem; margin: 1rem 0 1.5rem; font-size: .95rem; font-weight: 600; }
      @media (max-width: 520px) { .ob-ops { grid-template-columns: 1fr; } }

      /* Botón principal (Enviar / Reservar de catálogo / onboarding) */
      .btn-accion { padding: .8rem 1.5rem; border: 0; border-radius: 12px; background: var(--principal); color: #fff; font: inherit; font-weight: 600; cursor: pointer; transition: transform .15s ease, filter .2s ease; }
      .btn-accion:hover { transform: translateY(-2px); filter: brightness(1.05); }

      /* ---------- Modal ---------- */
      .modal-fondo { position: fixed; inset: 0; background: rgba(0,0,0,.5); display: none; place-items: center; padding: 1.2rem; z-index: 50; }
      .modal-fondo.abierto { display: grid; }
      .modal { background: #fff; border-radius: 16px; padding: 2rem; max-width: 440px; text-align: center; box-shadow: 0 14px 40px rgba(0,0,0,.2); }
      .modal h3 { font-size: 1.4rem; margin-bottom: .6rem; }
      .modal p { color: color-mix(in srgb, var(--tinta) 70%, transparent); margin: 0 0 1.4rem; }
      .modal .resumen { background: var(--suave); border-radius: 12px; padding: .8rem 1rem; margin: 0 0 1.2rem; font-size: .95rem; }
      .modal button { padding: .7rem 1.6rem; border: 0; border-radius: 10px; background: var(--principal); color: #fff; font: inherit; font-weight: 600; cursor: pointer; }

      .pie { border-top: 1px solid var(--linea); padding: 2rem 0 4.5rem; font-size: .9rem; color: color-mix(in srgb, var(--tinta) 60%, transparent); }
      .pie a { color: var(--principal); font-weight: 600; }

      /* ---------- FORMATOS ---------- */
      /* centrado: más compacto (columna estrecha, hero pequeño). */
      .fmt-centrado .env { max-width: 720px; }
      .fmt-centrado .hero { padding: 1rem 0 1.6rem; }
      .fmt-centrado .hero h1 { font-size: clamp(1.6rem, 4vw, 2.3rem); }
      .fmt-centrado .hero p { font-size: 1.05rem; }

      @media (min-width: 761px) {
        .fmt-lateral .reserva-cols { display: grid; grid-template-columns: 1fr 1.25fr; gap: 2.2rem; align-items: start; }
        .fmt-lateral .col-agenda { margin-top: 0; }
        .fmt-lateral .servicios { grid-template-columns: 1fr; }
      }

      .fmt-banda .cabecera { background: var(--principal); color: #fff; }
      .fmt-banda .cab-ini { background: #fff; color: var(--principal); }
      .fmt-banda .cab-rol { color: color-mix(in srgb, #fff 78%, transparent); }
      .fmt-banda .hero { padding-top: .5rem; }
      .fmt-banda .hero p { color: color-mix(in srgb, #fff 85%, transparent); }
      .fmt-banda main { margin-top: -1.5rem; }

      .fmt-elegante .cabecera { text-align: center; }
      .fmt-elegante .cab-fila { justify-content: center; }
      .fmt-elegante .hero { padding: 2rem 0 2.4rem; }
      .fmt-elegante .hero h1 { max-width: 24ch; margin-inline: auto; }
      .fmt-elegante .hero p { margin-inline: auto; }
      .fmt-elegante .hero h1::after { content: ""; display: block; width: 54px; height: 2px; background: var(--acento); margin: 1.2rem auto 0; }

      /* natural: fresco, centrado, redondeado y amable. */
      .fmt-natural .env { max-width: 760px; }
      .fmt-natural .cabecera { text-align: center; }
      .fmt-natural .cab-fila { justify-content: center; }
      .fmt-natural .hero { text-align: center; padding: 1.4rem 0 2rem; }
      .fmt-natural .hero h1 { margin-inline: auto; }
      .fmt-natural .hero p { margin-inline: auto; }
      .fmt-natural .panel { border-radius: 22px; }
      .fmt-natural .cab-ini { border-radius: 16px; }

      /* ---------- BOTONES por estilo ---------- */
      .btn-recto .hora, .btn-recto .cal-btn { border-radius: 5px; }
      .btn-pastilla .hora { border-radius: 999px; }
      .btn-contorno .hora { border-radius: 5px; background: transparent; border-color: var(--principal); color: var(--principal); font-weight: 500; }
      .btn-contorno .hora:hover { background: var(--principal); color: #fff; }
      .btn-contorno .cal-btn { border-radius: 5px; }

      @media (max-width: 560px) { .servicios { grid-template-columns: 1fr; } .campo-fila { grid-template-columns: 1fr; } .cal-rejilla { gap: .2rem; } }
    </style>
  </head>
  <body class={`fmt-${e.formato} btn-${e.boton}`} data-tipo={demo.tipo}>
    <div class="demo-cinta">
      <strong>Demostración</strong> · Ejemplo de web · Profesional ficticia, no se guarda ni envía nada real
    </div>

    <div class="cabecera">
      <header class="cab env">
        <div class="cab-fila">
          <span class="cab-ini" aria-hidden="true">{demo.inicial}</span>
          <span>
            <span class="cab-nombre">{demo.nombre}</span><br />
            <span class="cab-rol">{demo.rol}</span>
          </span>
        </div>
      </header>

      <section class="hero env">
        <h1>{demo.titulo}</h1>
        <p>{demo.lead}</p>
      </section>
    </div>

    <main class="env">
      {demo.tipo === "reservas" && (
        <section class="panel" aria-label="Reserva de cita (demostración)">
          <h2>Reservar</h2>
          <p class="ayuda">Ejemplo interactivo. Elige servicio, día y hora para ver el flujo completo.</p>
          <div class="reserva-cols">
            <div class="col-servicios">
              <p class="paso-titulo">1 · Elige el servicio</p>
              <div class="servicios" id="servicios">
                {demo.servicios.map((s, i) => (
                  <button class="servicio" data-nombre={s.nombre} data-dur={s.dur} data-precio={s.precio} aria-pressed={i === 0 ? "true" : "false"}>
                    <span class="servicio-nombre">{s.nombre}</span>
                    <span class="servicio-meta">{s.dur} · {s.precio}</span>
                  </button>
                ))}
              </div>
            </div>
            <div class="col-agenda">
              <p class="paso-titulo">2 · Elige el día</p>
              <div class="cal-cab">
                <span class="cal-mes" id="cal-mes">—</span>
                <div class="cal-nav">
                  <button class="cal-btn" id="cal-prev" aria-label="Mes anterior">‹</button>
                  <button class="cal-btn" id="cal-next" aria-label="Mes siguiente">›</button>
                </div>
              </div>
              <div class="cal-rejilla" id="cal-dow"></div>
              <div class="cal-rejilla" id="cal-dias"></div>
              <div class="horas">
                <p class="paso-titulo">3 · Elige la hora</p>
                <div class="horas-lista" id="horas-lista">
                  <span class="placeholder">Elige primero un día del calendario.</span>
                </div>
              </div>
            </div>
          </div>
        </section>
      )}

      {demo.tipo === "contacto" && (
        <section class="panel" aria-label="Contacto (demostración)">
          {/* Paso 1: elegir el área con tarjetas visuales. */}
          <div class="wiz-areas" id="wiz-areas">
            <h2>¿En qué podemos ayudarte?</h2>
            <p class="ayuda">Elige el área de tu asunto y te preparamos el formulario adecuado.</p>
            <div class="areas-grid">
              {(demo.areas ?? []).map((a, i) => (
                <button class="area-op" data-area={a}>
                  <span class="area-ico" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICONOS_AREA[i % ICONOS_AREA.length]} />
                  </span>
                  <span class="area-nombre">{a}</span>
                  <span class="area-flecha" aria-hidden="true">→</span>
                </button>
              ))}
            </div>
          </div>

          {/* Paso 2: formulario a medida (aparece al elegir área). */}
          <div class="wiz-form" id="wiz-form" hidden>
            <button class="wiz-volver" id="wiz-volver" type="button">← Cambiar de área</button>
            <h2>Cuéntanos tu caso</h2>
            <p class="ayuda">Asunto: <strong id="wiz-area-txt" class="wiz-chip"></strong>. Te contactamos en menos de 24 h.</p>
            <form class="form-grid" id="form-contacto" novalidate>
              <input type="hidden" name="area" id="c-area" />
              <div class="campo-fila">
                <div class="campo">
                  <label for="c-nombre">Nombre y apellidos</label>
                  <input id="c-nombre" name="nombre" type="text" required />
                </div>
                <div class="campo">
                  <label for="c-contacto">Email o teléfono</label>
                  <input id="c-contacto" name="contacto" type="text" required />
                </div>
              </div>
              <div class="campo">
                <label for="c-mensaje">Describe tu situación</label>
                <textarea id="c-mensaje" name="mensaje" required></textarea>
              </div>
              <label class="form-check">
                <input type="checkbox" id="c-privacidad" required />
                <span>He leído y acepto la política de privacidad. (Casilla de ejemplo.)</span>
              </label>
              <button type="submit" class="btn-accion">Enviar consulta</button>
            </form>
          </div>
        </section>
      )}

      {demo.tipo === "catalogo" && (
        <section class="panel" aria-label="Carta de tratamientos (demostración)">
          <h2>Tratamientos</h2>
          <p class="ayuda">Ejemplo interactivo. Explora la carta y pulsa «Reservar» en el que te interese.</p>
          <div class="carta">
            {demo.servicios.map((s) => (
              <article class="trato">
                <div class="trato-cab">
                  <span class="trato-nombre">{s.nombre}</span>
                  <span class="trato-precio">{s.precio}</span>
                </div>
                <p class="trato-dur">{s.dur}</p>
                {s.desc && <p class="trato-desc">{s.desc}</p>}
                <button class="btn-accion cta" data-nombre={s.nombre} data-precio={s.precio}>Reservar</button>
              </article>
            ))}
          </div>
        </section>
      )}

      {demo.tipo === "onboarding" && (
        <section class="panel ob" aria-label="Cuestionario (demostración)">
          <button class="ob-atras" id="ob-atras" type="button" hidden>← Atrás</button>
          <div class="ob-progreso"><span class="ob-barra" id="ob-barra"></span></div>
          <p class="ob-contador" id="ob-contador"></p>
          {(demo.pasos ?? []).map((paso, i) => (
            <div class="ob-paso" data-paso={i} hidden={i !== 0}>
              <h2>{paso.pregunta}</h2>
              <div class="ob-ops">
                {paso.opciones.map((o) => <button class="ob-op" data-valor={o}>{o}</button>)}
              </div>
            </div>
          ))}
          <div class="ob-paso ob-final" data-paso={(demo.pasos ?? []).length} hidden>
            <h2>¡Perfecto! Ya podemos empezar</h2>
            <p class="ayuda">Con tus respuestas preparamos tu plan a medida. Reserva tu primera consulta y nos ponemos en marcha.</p>
            <div class="ob-resumen" id="ob-resumen"></div>
            <button class="btn-accion" id="ob-reservar">Reservar primera consulta · {demo.servicios[0]?.precio}</button>
          </div>
        </section>
      )}
    </main>

    <footer class="pie env">
      Esto es una <strong>maqueta de demostración</strong>: «{demo.nombre}» no existe y no se guarda ni envía nada.
      Es un ejemplo del tipo de web que desarrollo. ¿Quieres una para tu negocio?
      <a href="/#contact">Hablemos</a>.
    </footer>

    <a class="volver" href="/demos/">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      Volver a las demos
    </a>

    <div class="modal-fondo" id="modal" role="dialog" aria-modal="true" aria-labelledby="modal-tit">
      <div class="modal">
        <h3 id="modal-tit">¡Así de fácil!</h3>
        <p id="modal-texto">En una web real, aquí se confirmaría la acción. Esto es una demostración: no se ha guardado nada.</p>
        <div class="resumen" id="modal-resumen" hidden></div>
        <button id="modal-cerrar">Entendido</button>
      </div>
    </div>

    <script>
      const $ = (id: string) => document.getElementById(id);
      const modal = $("modal");
      const abrirModal = (titulo: string, texto: string, resumen?: string) => {
        ($("modal-tit") as HTMLElement).textContent = titulo;
        ($("modal-texto") as HTMLElement).textContent = texto;
        const r = $("modal-resumen") as HTMLElement;
        if (resumen) { r.textContent = resumen; r.hidden = false; } else { r.hidden = true; }
        modal?.classList.add("abierto");
      };
      $("modal-cerrar")?.addEventListener("click", () => modal?.classList.remove("abierto"));
      modal?.addEventListener("click", (ev) => { if (ev.target === modal) modal.classList.remove("abierto"); });
      document.addEventListener("keydown", (ev) => { if (ev.key === "Escape") modal?.classList.remove("abierto"); });

      // ---------- RESERVAS ----------
      if ($("cal-dias")) {
        const MESES = ["enero","febrero","marzo","abril","mayo","junio","julio","agosto","septiembre","octubre","noviembre","diciembre"];
        const DOW = ["L","M","X","J","V","S","D"];
        const HORAS = ["10:00","10:45","11:30","12:15","17:00","17:45","18:30"];
        let servicio: { nombre: string; dur: string; precio: string } | null = null;
        let diaSel: Date | null = null;
        const hoy = new Date();
        let verMes = new Date(hoy.getFullYear(), hoy.getMonth(), 1);

        const leerServicio = (b: HTMLElement) => { servicio = { nombre: b.dataset.nombre!, dur: b.dataset.dur!, precio: b.dataset.precio! }; };
        const prim = document.querySelector<HTMLElement>('.servicio[aria-pressed="true"]');
        if (prim) leerServicio(prim);
        document.querySelectorAll<HTMLElement>(".servicio").forEach((b) => {
          b.addEventListener("click", () => {
            document.querySelectorAll(".servicio").forEach((o) => o.setAttribute("aria-pressed", "false"));
            b.setAttribute("aria-pressed", "true");
            leerServicio(b);
          });
        });
        ($("cal-dow") as HTMLElement).innerHTML = DOW.map((d) => `<div class="cal-dow">${d}</div>`).join("");

        const libre = (fecha: Date) => {
          const dow = fecha.getDay();
          if (dow === 0 || dow === 6) return false;
          const manana = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate() + 1);
          if (fecha < manana) return false;
          return fecha.getDate() % 3 !== 0;
        };
        const pintarMes = () => {
          ($("cal-mes") as HTMLElement).textContent = `${MESES[verMes.getMonth()]} ${verMes.getFullYear()}`;
          const primeroMes = new Date(verMes.getFullYear(), verMes.getMonth(), 1);
          const offset = (primeroMes.getDay() + 6) % 7;
          const diasMes = new Date(verMes.getFullYear(), verMes.getMonth() + 1, 0).getDate();
          let html = "";
          for (let i = 0; i < offset; i++) html += `<span class="cal-dia vacio"></span>`;
          for (let d = 1; d <= diasMes; d++) {
            const fecha = new Date(verMes.getFullYear(), verMes.getMonth(), d);
            html += libre(fecha) ? `<button class="cal-dia libre" data-dia="${d}">${d}</button>` : `<span class="cal-dia nodisp">${d}</span>`;
          }
          ($("cal-dias") as HTMLElement).innerHTML = html;
          $("cal-dias")!.querySelectorAll<HTMLElement>(".libre").forEach((b) => b.addEventListener("click", () => elegirDia(parseInt(b.dataset.dia!, 10), b)));
          ($("cal-prev") as HTMLButtonElement).disabled = verMes <= new Date(hoy.getFullYear(), hoy.getMonth(), 1);
        };
        const elegirDia = (d: number, btn: HTMLElement) => {
          diaSel = new Date(verMes.getFullYear(), verMes.getMonth(), d);
          document.querySelectorAll(".cal-dia").forEach((x) => x.classList.remove("sel"));
          btn.classList.add("sel");
          ($("horas-lista") as HTMLElement).innerHTML = HORAS.map((h) => `<button class="hora" data-hora="${h}">${h}</button>`).join("");
          $("horas-lista")!.querySelectorAll<HTMLElement>(".hora").forEach((b) => b.addEventListener("click", () => {
            const f = diaSel!.toLocaleDateString("es-ES", { weekday: "long", day: "numeric", month: "long" });
            abrirModal("¡Así de fácil!", "En una web real, aquí se confirmaría tu cita y recibirías un correo. Es una demostración.", `${servicio!.nombre} (${servicio!.dur} · ${servicio!.precio}) · ${f} a las ${b.dataset.hora}`);
          }));
        };
        $("cal-prev")?.addEventListener("click", () => { verMes = new Date(verMes.getFullYear(), verMes.getMonth() - 1, 1); pintarMes(); });
        $("cal-next")?.addEventListener("click", () => { verMes = new Date(verMes.getFullYear(), verMes.getMonth() + 1, 1); pintarMes(); });
        pintarMes();
      }

      // ---------- CONTACTO (asistente en 2 pasos) ----------
      const form = $("form-contacto") as HTMLFormElement | null;
      if (form) {
        const wizAreas = $("wiz-areas");
        const wizForm = $("wiz-form");
        const areaTxt = $("wiz-area-txt");
        const areaInput = $("c-area") as HTMLInputElement;
        const paso1 = () => { wizForm!.hidden = true; wizAreas!.hidden = false; };
        const paso2 = (area: string) => {
          areaInput.value = area;
          if (areaTxt) areaTxt.textContent = area;
          wizAreas!.hidden = true;
          wizForm!.hidden = false;
          ($("c-nombre") as HTMLInputElement | null)?.focus();
        };
        document.querySelectorAll<HTMLElement>(".area-op").forEach((b) => b.addEventListener("click", () => paso2(b.dataset.area || "")));
        $("wiz-volver")?.addEventListener("click", paso1);
        form.addEventListener("submit", (ev) => {
          ev.preventDefault();
          const nombre = (form.elements.namedItem("nombre") as HTMLInputElement).value.trim();
          const contacto = (form.elements.namedItem("contacto") as HTMLInputElement).value.trim();
          const mensaje = (form.elements.namedItem("mensaje") as HTMLTextAreaElement).value.trim();
          const acepta = ($("c-privacidad") as HTMLInputElement).checked;
          if (!nombre || !contacto || !mensaje || !acepta) { form.reportValidity(); return; }
          const area = areaInput.value;
          form.reset();
          abrirModal("¡Mensaje enviado!", "En una web real, tu consulta llegaría al despacho y te responderían en menos de 24 h. Es una demostración: no se ha enviado nada.", `${nombre} · ${area}`);
          paso1();
        });
      }

      // ---------- CATÁLOGO ----------
      document.querySelectorAll<HTMLElement>(".trato .cta").forEach((b) => {
        b.addEventListener("click", () => {
          abrirModal("¡Reserva iniciada!", "En una web real, aquí elegirías día y hora y confirmarías. Es una demostración: no se ha guardado nada.", `${b.dataset.nombre} · ${b.dataset.precio}`);
        });
      });

      // ---------- ONBOARDING (cuestionario por pasos) ----------
      const obPasos = Array.from(document.querySelectorAll<HTMLElement>(".ob-paso"));
      if (obPasos.length) {
        const total = obPasos.length; // preguntas + paso final
        const respuestas: string[] = [];
        const barra = $("ob-barra") as HTMLElement;
        const contador = $("ob-contador") as HTMLElement;
        const atras = $("ob-atras") as HTMLButtonElement;
        let idx = 0;
        const mostrar = (n: number) => {
          idx = Math.max(0, Math.min(total - 1, n));
          obPasos.forEach((p, i) => (p.hidden = i !== idx));
          barra.style.width = `${(idx / (total - 1)) * 100}%`;
          contador.textContent = `Paso ${idx + 1} de ${total}`;
          atras.hidden = idx === 0;
          if (idx === total - 1) ($("ob-resumen") as HTMLElement).textContent = respuestas.filter(Boolean).join(" · ");
        };
        obPasos.forEach((p, i) => {
          p.querySelectorAll<HTMLElement>(".ob-op").forEach((b) => b.addEventListener("click", () => {
            respuestas[i] = b.dataset.valor || "";
            mostrar(i + 1);
          }));
        });
        atras.addEventListener("click", () => mostrar(idx - 1));
        $("ob-reservar")?.addEventListener("click", () => abrirModal(
          "¡Todo listo!",
          "En una web real, aquí elegirías día y hora y confirmarías tu primera consulta. Es una demostración: no se ha guardado nada.",
          respuestas.filter(Boolean).join(" · "),
        ));
        mostrar(0);
      }
    </script>
  </body>
</html>
