---
import { content, type Lang } from "../i18n/content";
import Gallery from "./Gallery.astro";
import { demos } from "../lib/demos";
import { marcasTemporada } from "../lib/worldAthletics";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];

// Marcas de la temporada, en vivo desde World Athletics (en tiempo de build).
// Si la API no responde, `temporada` es null y no se muestra el bloque.
const temporada = await marcasTemporada(lang);

/**
 * Red de seguridad: nada que siga marcado como pendiente (texto entre
 * corchetes, tipo [COMPLETAR: ...]) debe llegar nunca a la pantalla.
 * Así la web siempre se ve acabada aunque queden datos por rellenar.
 */
const pendiente = (s: string) => s.trim().startsWith("[");
const limpiar = (s: string) => s.replace(/\s*\[(COMPLETAR|CONFIRMAR)[^\]]*\]/g, "").trim();

const parrafos = t.about.paragraphs.filter((p) => !pendiente(p)).map(limpiar);
const bloques = t.projects.featured.blocks.filter((b) => !pendiente(b.text)).map((b) => ({ ...b, text: limpiar(b.text) }));
const decisiones = t.projects.featured.highlights.filter((h) => !pendiente(h)).map(limpiar);
const grupos = t.stack.groups.map((g) => ({ ...g, items: g.items.filter((i) => !pendiente(i)) }));
const limpiarItem = (e: { period: string; role: string; place: string; detail: string }) => ({
  ...e,
  detail: limpiar(e.detail),
  place: limpiar(e.place),
});
const trabajo = t.experience.work.map(limpiarItem);
const trayectoria = t.experience.items.map(limpiarItem);

// Enlace a GitHub (para "ver más proyectos"), tomado de las redes.
const github = t.contact.socials.find((s) => s.label === "GitHub")?.url;
// Lista de proyectos para el carrusel: el destacado (Kaireté) va primero.
const proyectos = [
  {
    title: t.projects.featured.title,
    status: t.projects.featured.status,
    tagline: t.projects.featured.tagline,
    blocks: bloques,
    tags: t.projects.featured.tags,
    link: t.projects.featured.link,
    repo: t.projects.featured.repo,
  },
  ...t.projects.items.map((p) => ({
    title: p.title,
    status: "",
    tagline: p.description,
    blocks: [],
    tags: p.tags,
    link: p.link,
    repo: p.repo,
  })),
];
---

<!-- ===================== HERO ===================== -->
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="hero-eyebrow">{t.hero.eyebrow}</span>
      <h1 class="hero-title"><span class="grad">{t.hero.name}</span></h1>
      <p class="hero-roles" data-roles={JSON.stringify(t.hero.roles)}>
        <span class="sep">&gt;</span> <span class="typed">{t.hero.roles[0]}</span><span class="caret">_</span>
      </p>
      <p class="hero-lead">{t.hero.lead}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#projects">{t.hero.ctaProjects}</a>
        <a class="btn btn-ghost" href="#contact">{t.hero.ctaContact}</a>
      </div>
    </div>

    <div class="hero-portrait">
      <Gallery
        photos={t.sport.gallery.filter((p) => p.format === "tall")}
        lang={lang}
        ratio="3 / 4"
        autoplay={5000}
      />
    </div>
  </div>
</section>

<!-- ===================== SOBRE MÍ ===================== -->
<section class="section" id="about">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t.about.eyebrow}</p>
      <h2 class="section-title">{t.about.title}</h2>
    </div>
    <div class="about-grid">
      <div class="about-text">
        {parrafos.map((p) => <p>{p}</p>)}
      </div>
      <dl class="about-facts">
        {t.about.facts.map((f) => (
          <div class="fact">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<!-- ===================== PROYECTOS ===================== -->
<section class="section" id="projects">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t.projects.eyebrow}</p>
      <h2 class="section-title">{t.projects.title}</h2>
      <p class="section-sub">{t.projects.sub}</p>
    </div>

    <!-- Carrusel de proyectos (una tarjeta a la vez): Kaireté, los próximos que
         vengan, y una tarjeta final que enlaza a GitHub. Flechas + puntos. -->
    <div class="proy-car" data-proy-car>
      <div class="proy-viewport">
        <div class="proy-track">
          {proyectos.map((p) => (
            <article class="proyecto-card">
              <div class="proyecto-top">
                <h3>{p.title}</h3>
                {p.status && <span class="featured-status">{p.status}</span>}
              </div>
              <p class="proyecto-tagline">{p.tagline}</p>
              {p.blocks.map((b) => (
                <div class="proyecto-block">
                  <h4>{b.label}</h4>
                  <p>{b.text}</p>
                </div>
              ))}
              <ul class="tags">{p.tags.map((tag) => <li>{tag}</li>)}</ul>
              {(p.link || p.repo) && (
                <div class="project-links">
                  {p.link && <a href={p.link} target="_blank" rel="noopener">↗ {lang === "es" ? "Visitar" : "Visit"} {p.title}</a>}
                  {p.repo && <a href={p.repo} target="_blank" rel="noopener">↗ {lang === "es" ? "Código" : "Code"}</a>}
                </div>
              )}
            </article>
          ))}

          {github && (
            <article class="proyecto-card proy-github">
              <div class="proyecto-top">
                <h3>{lang === "es" ? "Más en GitHub" : "More on GitHub"}</h3>
                <span class="featured-status">{lang === "es" ? "Código abierto" : "Open source"}</span>
              </div>
              <p class="proyecto-tagline">
                {lang === "es"
                  ? "Todo mi código, experimentos y proyectos personales están publicados en mi perfil de GitHub. Ahí verás en qué ando trabajando de verdad."
                  : "All my code, experiments and personal projects are published on my GitHub profile — that's where you'll see what I'm really building."}
              </p>
              <div class="project-links">
                <a href={github} target="_blank" rel="noopener">↗ {lang === "es" ? "Ver mi GitHub" : "View my GitHub"}</a>
              </div>
            </article>
          )}
        </div>
      </div>

      <div class="proy-controls" hidden>
        <button class="proy-arrow" data-proy-dir="prev" aria-label={lang === "es" ? "Proyecto anterior" : "Previous project"}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="proy-dots" role="tablist" aria-label={lang === "es" ? "Proyectos" : "Projects"}></div>
        <button class="proy-arrow" data-proy-dir="next" aria-label={lang === "es" ? "Proyecto siguiente" : "Next project"}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
    </div>

    <!-- Producto propio: webs a medida. El botón abre el catálogo /demos en otra pestaña. -->
    <div class="demos-cta" id="service">
      <div class="demos-cta-copy">
        <p class="eyebrow">{t.service.eyebrow}</p>
        <h3 class="demos-cta-title">{t.service.title}</h3>
        <p class="demos-cta-text">{t.service.text}</p>
      </div>
      <a class="btn btn-primary demos-cta-btn" href="/demos/" target="_blank" rel="noopener">{t.service.cta} ↗</a>
    </div>
  </div>
</section>

<!-- ===================== EXPERIENCIA ===================== -->
<section class="section" id="experience">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t.experience.eyebrow}</p>
      <h2 class="section-title">{t.experience.title}</h2>
    </div>
    <h3 class="bests-title">{t.experience.workTitle}</h3>
    <div class="timeline">
      {trabajo.map((e) => (
        <div class="tl-item">
          <span class="tl-year">{e.period}</span>
          <div class="tl-body">
            <h3>{e.role}</h3>
            {e.place && <p class="tl-place">{e.place}</p>}
            {e.detail && <p>{e.detail}</p>}
          </div>
        </div>
      ))}
    </div>

    <h3 class="bests-title timeline-gap">{t.experience.educationTitle}</h3>
    <div class="timeline">
      {trayectoria.map((e) => (
        <div class="tl-item">
          <span class="tl-year">{e.period}</span>
          <div class="tl-body">
            <h3>{e.role}</h3>
            {e.place && <p class="tl-place">{e.place}</p>}
            {e.detail && <p>{e.detail}</p>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===================== STACK ===================== -->
<section class="section" id="stack">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t.stack.eyebrow}</p>
      <h2 class="section-title">{t.stack.title}</h2>
    </div>
    <div class="stack-grid">
      {grupos.map((g) => (
        <div class="stack-group">
          <h3>{g.name}</h3>
          <ul>{g.items.map((it) => <li>{it}</li>)}</ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===================== TRAYECTORIA DEPORTIVA ===================== -->
<!-- Al cierre, como broche, y visible directamente (sin desplegable). -->
<section class="section" id="sport">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t.sport.eyebrow}</p>
      <h2 class="section-title">{t.sport.title}</h2>
      <p class="section-sub">{t.sport.sub}</p>
    </div>

    {temporada && (
      <div class="season">
        <h3 class="bests-title season-head">
          {lang === "es" ? `Temporada ${temporada.season}` : `${temporada.season} season`}
          <span class="live" title={lang === "es" ? "Datos oficiales de World Athletics" : "Official World Athletics data"}>
            <span class="live-dot"></span>{lang === "es" ? "en directo" : "live"}
          </span>
        </h3>
        <div class="bests">
          {temporada.marcas.map((b) => (
            <div class="best">
              <span class="best-event">{b.event}</span>
              <span class="best-mark">{b.mark}</span>
              <span class="best-note">{b.note}</span>
            </div>
          ))}
        </div>
        <p class="season-src">
          {lang === "es" ? "Mejores marcas legales de la temporada, sincronizadas desde " : "Season's best legal marks, synced from "}
          <a href="https://worldathletics.org/athletes/spain/jose-giner-14879964" target="_blank" rel="noopener">World Athletics</a>.
        </p>
      </div>
    )}

    <h3 class="bests-title">{t.sport.bestsTitle}</h3>
    <div class="bests">
      {t.sport.bests.map((b) => (
        <div class="best">
          <span class="best-event">{b.event}</span>
          <span class="best-mark">{b.mark}</span>
          <span class="best-note">{b.note}</span>
        </div>
      ))}
    </div>

    <Gallery
      photos={t.sport.gallery.filter((p) => p.format === "wide")}
      title={t.sport.galleryTitle}
      lang={lang}
      ratio="3 / 2"
    />

    <div class="timeline">
      {t.sport.achievements.slice(0, 4).map((a) => (
        <div class="tl-item">
          <span class="tl-year">{a.year}</span>
          <div class="tl-body">
            <h3>{a.title}</h3>
            {a.detail && <p>{a.detail}</p>}
          </div>
        </div>
      ))}
    </div>

    {t.sport.achievements.length > 4 && (
      <details class="mas-hitos">
        <summary class="mas-hitos-btn">
          <span data-mas={lang === "es" ? `Ver ${t.sport.achievements.length - 4} hitos más` : `Show ${t.sport.achievements.length - 4} more`}
                data-menos={lang === "es" ? "Ver menos" : "Show less"}></span>
          <svg class="fold-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </summary>
        <div class="timeline timeline-gap">
          {t.sport.achievements.slice(4).map((a) => (
            <div class="tl-item">
              <span class="tl-year">{a.year}</span>
              <div class="tl-body">
                <h3>{a.title}</h3>
                {a.detail && <p>{a.detail}</p>}
              </div>
            </div>
          ))}
        </div>
      </details>
    )}
  </div>
</section>

<!-- ===================== CONTACTO ===================== -->
<section class="section contact" id="contact">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t.contact.eyebrow}</p>
      <h2 class="section-title">{t.contact.title}</h2>
      <p class="section-sub">{t.contact.lead}</p>
    </div>
    <div class="contact-card">
      <a class="contact-email" href={`mailto:${t.contact.email}`}>{t.contact.email}</a>
      <a class="btn btn-primary" href={`mailto:${t.contact.email}`}>{t.contact.ctaEmail}</a>
    </div>
    <ul class="socials">
      {t.contact.socials.map((s) => (
        <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Efecto de "typing" en los roles del hero
  const el = document.querySelector<HTMLElement>(".hero-roles");
  const typed = document.querySelector<HTMLElement>(".hero-roles .typed");
  if (el && typed && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const roles: string[] = JSON.parse(el.dataset.roles || "[]");
    let ri = 0, ci = 0, deleting = false;
    const tick = () => {
      const word = roles[ri];
      typed.textContent = word.slice(0, ci);
      if (!deleting && ci < word.length) { ci++; }
      else if (deleting && ci > 0) { ci--; }
      else if (!deleting && ci === word.length) { deleting = true; setTimeout(tick, 1600); return; }
      else { deleting = false; ri = (ri + 1) % roles.length; }
      setTimeout(tick, deleting ? 45 : 90);
    };
    setTimeout(tick, 800);
  }

  // Carrusel de proyectos: una tarjeta a la vez, con flechas, puntos y swipe.
  document.querySelectorAll<HTMLElement>("[data-proy-car]").forEach((root) => {
    const track = root.querySelector<HTMLElement>(".proy-track");
    const slides = Array.from(root.querySelectorAll<HTMLElement>(".proyecto-card"));
    const controls = root.querySelector<HTMLElement>(".proy-controls");
    const dotsWrap = root.querySelector<HTMLElement>(".proy-dots");
    if (!track || !controls || !dotsWrap || slides.length < 2) return; // 1 tarjeta: sin controles
    controls.hidden = false;

    let index = 0;
    const go = (i: number) => {
      index = (i + slides.length) % slides.length;
      track.style.transform = `translateX(${-index * 100}%)`;
      dots.forEach((d, n) => d.classList.toggle("active", n === index));
    };

    slides.forEach((_, i) => {
      const dot = document.createElement("button");
      dot.className = "proy-dot";
      dot.setAttribute("aria-label", `${i + 1}`);
      dot.addEventListener("click", () => go(i));
      dotsWrap.appendChild(dot);
    });
    const dots = Array.from(dotsWrap.children) as HTMLElement[];

    root.querySelectorAll<HTMLButtonElement>("[data-proy-dir]").forEach((btn) => {
      btn.addEventListener("click", () => go(index + (btn.dataset.proyDir === "next" ? 1 : -1)));
    });

    const vp = root.querySelector<HTMLElement>(".proy-viewport");
    let startX = 0;
    vp?.addEventListener("touchstart", (e) => { startX = e.touches[0].clientX; }, { passive: true });
    vp?.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) go(index + (dx < 0 ? 1 : -1));
    }, { passive: true });

    go(0);
  });
</script>

<style>
  .caret { color: var(--accent); animation: blink 1s step-end infinite; }
  @keyframes blink { 50% { opacity: 0; } }
</style>
