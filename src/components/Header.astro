---
import { content, type Lang } from "../i18n/content";
import Logo from "./Logo.astro";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang].nav;
// Rutas: español en la raíz, inglés en /en/
const esHref = "/";
const enHref = "/en/";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={lang === "es" ? esHref : enHref} aria-label="JGP Developlete"><Logo /></a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="nav-menu">
      <span class="sr-only">Menu</span>
      <span class="nav-toggle-bar"></span>
    </button>

    <ul class="nav-menu" id="nav-menu">
      <li><a href="#about">{t.about}</a></li>
      <li><a href="#experience">{t.experience}</a></li>
      <li><a href="#projects">{t.projects}</a></li>
      <li><a href="#sport">{t.sport}</a></li>
      <li><a href="#contact">{t.contact}</a></li>
      <!-- Idioma y color juntos, en una sola fila (también en el menú móvil). -->
      <li class="switches">
        <span class="lang-switch">
          <a href={esHref} class={lang === "es" ? "active" : ""}>ES</a>
          <a href={enHref} class={lang === "en" ? "active" : ""}>EN</a>
        </span>
        <button class="mode-toggle" id="mode-toggle" type="button" aria-pressed="false"
                title={lang === "es" ? "Modo claro u oscuro" : "Light or dark mode"}
                aria-label={lang === "es" ? "Cambiar entre modo claro y oscuro" : "Toggle light and dark mode"}>
          <span class="mode-emoji" aria-hidden="true">☀️</span>
        </button>
        <span class="theme-switch" role="group" aria-label={lang === "es" ? "Color de la web" : "Site colour"}>
          <button class="theme-dot pista" data-theme-set="pista" aria-pressed="false" title="Pista"><span class="sr-only">Pista</span></button>
          <button class="theme-dot bosque" data-theme-set="bosque" aria-pressed="false" title="Bosque"><span class="sr-only">Bosque</span></button>
          <button class="theme-dot grafito" data-theme-set="grafito" aria-pressed="false" title="Grafito"><span class="sr-only">Grafito</span></button>
          <button class="theme-dot regata" data-theme-set="regata" aria-pressed="false" title="Regata"><span class="sr-only">Regata</span></button>
        </span>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector(".nav-toggle");
  const menu = document.getElementById("nav-menu");
  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const open = menu.classList.toggle("open");
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
    });
    menu.addEventListener("click", (e) => {
      const el = e.target as HTMLElement;
      if (el.tagName === "A" && !el.closest(".lang-switch")) {
        menu.classList.remove("open");
        toggle.setAttribute("aria-expanded", "false");
      }
    });
  }
</script>
