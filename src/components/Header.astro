---
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang].nav;
// Rutas: español en la raíz, inglés en /en/
const esHref = "/";
const enHref = "/en/";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={lang === "es" ? esHref : enHref}>JG<span class="dot">.</span></a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="nav-menu">
      <span class="sr-only">Menu</span>
      <span class="nav-toggle-bar"></span>
    </button>

    <ul class="nav-menu" id="nav-menu">
      <li><a href="#about">{t.about}</a></li>
      <li><a href="#projects">{t.projects}</a></li>
      <li><a href="#stack">{t.stack}</a></li>
      <li><a href="#sport">{t.sport}</a></li>
      <li><a href="#experience">{t.experience}</a></li>
      <li><a href="#contact">{t.contact}</a></li>
      <li>
        <span class="lang-switch">
          <a href={esHref} class={lang === "es" ? "active" : ""}>ES</a>
          <a href={enHref} class={lang === "en" ? "active" : ""}>EN</a>
        </span>
      </li>
      <li>
        <span class="theme-switch" role="group" aria-label={lang === "es" ? "Color de la web" : "Site colour"}>
          <button class="theme-dot pista" data-theme-set="pista" aria-pressed="false" title="Pista"><span class="sr-only">Pista</span></button>
          <button class="theme-dot velocidad" data-theme-set="velocidad" aria-pressed="false" title="Velocidad"><span class="sr-only">Velocidad</span></button>
          <button class="theme-dot atardecer" data-theme-set="atardecer" aria-pressed="false" title="Atardecer"><span class="sr-only">Atardecer</span></button>
          <button class="theme-dot claro" data-theme-set="claro" aria-pressed="false" title={lang === "es" ? "Claro" : "Light"}><span class="sr-only">Claro</span></button>
        </span>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector(".nav-toggle");
  const menu = document.getElementById("nav-menu");
  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const open = menu.classList.toggle("open");
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
    });
    menu.addEventListener("click", (e) => {
      const el = e.target as HTMLElement;
      if (el.tagName === "A" && !el.closest(".lang-switch")) {
        menu.classList.remove("open");
        toggle.setAttribute("aria-expanded", "false");
      }
    });
  }
</script>
