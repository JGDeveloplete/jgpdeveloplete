---
import type { Photo, Lang } from "../i18n/content";

interface Props {
  photos: Photo[];
  title: string;
  lang: Lang;
  /** Proporción del escenario, p. ej. "3 / 2" (apaisado) o "2 / 3" (vertical). */
  ratio: string;
  /** Ancho máximo. Útil para que el carrusel vertical no domine la página. */
  maxWidth?: string;
}
const { photos, title, lang, ratio, maxWidth } = Astro.props;

const prevLabel = lang === "es" ? "Foto anterior" : "Previous photo";
const nextLabel = lang === "es" ? "Foto siguiente" : "Next photo";
---

{photos.length > 0 && (
  <div class="gallery" style={`--ratio: ${ratio}; ${maxWidth ? `max-width: ${maxWidth}; margin-inline: auto;` : ""}`}>
    <h3 class="bests-title">{title}</h3>

    <div class="gallery-viewport">
      <div class="gallery-track">
        {photos.map((p, i) => (
          <figure class="slide" style={`--foto: url('${p.src}.webp')`}>
            <picture>
              <source srcset={`${p.src}.webp`} type="image/webp" />
              <img
                src={`${p.src}.jpg`}
                alt={p.alt}
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            </picture>
            <figcaption>{p.caption}</figcaption>
          </figure>
        ))}
      </div>

      {photos.length > 1 && (
        <>
          <button class="gallery-arrow prev" data-dir="prev" aria-label={prevLabel}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button class="gallery-arrow next" data-dir="next" aria-label={nextLabel}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
          </button>
        </>
      )}
    </div>

    {photos.length > 1 && <div class="gallery-dots" role="tablist" aria-label={title}></div>}
  </div>
)}

<script>
  // Puede haber varios carruseles en la página (apaisado y vertical),
  // así que cada uno se inicializa por separado.
  document.querySelectorAll<HTMLElement>(".gallery").forEach((root) => {
    const track = root.querySelector<HTMLElement>(".gallery-track");
    const slides = Array.from(root.querySelectorAll<HTMLElement>(".slide"));
    const dotsWrap = root.querySelector<HTMLElement>(".gallery-dots");
    if (!track || slides.length < 2) return;

    let index = 0;

    if (dotsWrap) {
      slides.forEach((_, i) => {
        const dot = document.createElement("button");
        dot.setAttribute("aria-label", `${i + 1}`);
        dot.addEventListener("click", () => go(i));
        dotsWrap.appendChild(dot);
      });
    }
    const dots = dotsWrap ? (Array.from(dotsWrap.children) as HTMLElement[]) : [];

    // Las diapositivas están desplazadas en horizontal y fuera del viewport,
    // así que el navegador no dispara la carga diferida hasta que ya se ven.
    // Adelantamos la actual y sus vecinas para que no aparezca un hueco.
    const precargar = (i: number) => {
      [i - 1, i, i + 1].forEach((n) => {
        const img = slides[(n + slides.length) % slides.length]?.querySelector("img");
        if (img && img.loading === "lazy") img.loading = "eager";
      });
    };

    const render = () => {
      track.style.transform = `translateX(${-index * 100}%)`;
      dots.forEach((d, i) => d.classList.toggle("active", i === index));
      slides.forEach((s, i) => s.setAttribute("aria-hidden", String(i !== index)));
      precargar(index);
    };
    const go = (i: number) => {
      index = (i + slides.length) % slides.length;
      render();
    };

    root.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((btn) => {
      btn.addEventListener("click", () => go(index + (btn.dataset.dir === "next" ? 1 : -1)));
    });

    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") go(index + 1);
      else if (e.key === "ArrowLeft") go(index - 1);
    });

    let startX = 0;
    root.addEventListener("touchstart", (e) => { startX = e.touches[0].clientX; }, { passive: true });
    root.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) go(index + (dx < 0 ? 1 : -1));
    }, { passive: true });

    render();
  });
</script>
